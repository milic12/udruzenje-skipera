---
import type { ImageMetadata } from 'astro';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';

interface Props {
	title?: string;
	description?: string;
	image?: ImageMetadata | string;
	/** Transparent header laid over a full-screen hero (home page). */
	overlayHeader?: boolean;
}

const { title = SITE_TITLE, description = SITE_DESCRIPTION, image, overlayHeader = false } = Astro.props;
---

<!doctype html>
<html lang="sr-ME">
	<head>
		<BaseHead title={title} description={description} image={image} />
		{/* Staging builds (npm run deploy:staging) must not be indexed by search engines. */}
		{import.meta.env.PUBLIC_SITE_ENV === 'staging' && <meta name="robots" content="noindex, nofollow" />}
	</head>
	<body class="flex min-h-screen flex-col">
		<Header overlay={overlayHeader} />
		<main class="flex-1">
			<slot />
		</main>
		<Footer />
	</body>
</html>
