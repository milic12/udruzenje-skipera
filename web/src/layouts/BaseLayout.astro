---
import type { ImageMetadata } from 'astro';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';

interface Props {
	title?: string;
	description?: string;
	image?: ImageMetadata | string;
	/** Transparent header laid over a full-screen hero (home page). */
	overlayHeader?: boolean;
	/** No header/footer coming-soon page */
	bare?: boolean;
}

const { title = SITE_TITLE, description = SITE_DESCRIPTION, image, overlayHeader = false, bare = false } = Astro.props;

// Staging must never be indexed. 
const comingSoon = import.meta.env.PUBLIC_COMING_SOON === 'true';
const noindex = import.meta.env.PUBLIC_SITE_ENV === 'staging' || (comingSoon && Astro.url.pathname !== '/');
---

<!doctype html>
<html lang="sr-ME">
	<head>
		<BaseHead title={title} description={description} image={image} />
		{noindex && <meta name="robots" content="noindex, nofollow" />}
	</head>
	<body class="flex min-h-screen flex-col">
		{!bare && <Header overlay={overlayHeader} />}
		<main class="flex-1">
			<slot />
		</main>
		{!bare && <Footer />}
	</body>
</html>
