---
import { PortableText } from 'astro-portabletext';
import FormattedDate from '../../components/FormattedDate.astro';
import PageHeader from '../../components/PageHeader.astro';
import PtImage from '../../components/portable-text/PtImage.astro';
import SanityImage from '../../components/SanityImage.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { SITE_TITLE } from '../../consts';
import { urlFor } from '../../utils/image';
import { getActivity, getActivitySlugs } from '../../utils/sanity';

export async function getStaticPaths() {
	const slugs = await getActivitySlugs();
	return slugs.map((slug) => ({ params: { slug } }));
}

const { slug } = Astro.params;
const activity = await getActivity(slug!);
if (!activity) return Astro.redirect('/aktivnosti/');

const { title, date, location, lead, mainImage, body, gallery, guests } = activity;
const { attendanceInPerson, attendanceOnline } = activity;

const hasMeetingInfo = attendanceInPerson != null || attendanceOnline != null || !!guests?.length;
const attendance = [
	attendanceInPerson != null && `${attendanceInPerson} uživo`,
	attendanceOnline != null && `${attendanceOnline} online`,
].filter(Boolean);

const ogImage = mainImage?.asset
	? urlFor(mainImage).width(1200).height(630).fit('crop').url()
	: undefined;

const components = { type: { image: PtImage } };
---

<BaseLayout title={`${title} | ${SITE_TITLE}`} description={lead ?? undefined} image={ogImage}>
	<PageHeader title={title ?? 'Aktivnost'} titleClass="mt-8" />

	<article class="bg-white pb-20 md:pb-28">
		<div class="container-site max-w-3xl">
			<div class="flex flex-wrap items-center justify-between gap-3 border-b border-black/10 pb-6">
				<p class="eyebrow text-primary">
					{date && <FormattedDate date={date} />}
					{location && <span> · {location}</span>}
				</p>
				<a href="/aktivnosti/" class="text-sm font-semibold text-primary hover:text-accent">
					← Sve aktivnosti
				</a>
			</div>

			{lead && <p class="mt-8 text-xl leading-relaxed text-dark">{lead}</p>}

			{
				mainImage?.asset && (
					<SanityImage
						image={mainImage}
						widths={[640, 960, 1440]}
						sizes="(min-width: 768px) 768px, 100vw"
						loading="eager"
						class="mx-auto mt-10 max-h-[80vh] w-auto rounded-2xl shadow-lg"
					/>
				)
			}

			{
				hasMeetingInfo && (
					<aside class="mt-10 rounded-xl bg-light p-6">
						<h2 class="eyebrow text-primary">Detalji sastanka</h2>
						{attendance.length > 0 && (
							<p class="mt-3 text-dark">
								<span class="font-semibold">Prisutno:</span> {attendance.join(' · ')}
							</p>
						)}
						{guests && guests.length > 0 && (
							<div class="mt-3">
								<p class="font-semibold text-dark">Gosti:</p>
								<ul class="mt-1 space-y-1 text-muted">
									{guests.map((g) => (
										<li>
											<span class="text-dark">{g.name}</span>
											{g.role && <span> – {g.role}</span>}
										</li>
									))}
								</ul>
							</div>
						)}
					</aside>
				)
			}

			{
				body && (
					<div class="prose prose-lg mt-10 max-w-none prose-headings:font-heading prose-headings:text-dark prose-a:text-primary">
						<PortableText value={body} components={components} />
					</div>
				)
			}

			{
				gallery && gallery.length > 0 && (
					<section class="mt-14">
						<h2 class="text-2xl font-semibold text-dark">Fotografije</h2>
						<div class="mt-6 grid grid-cols-2 gap-3 md:grid-cols-3">
							{gallery.map((img) => (
								<SanityImage
									image={img}
									aspect={1}
									widths={[300, 600]}
									sizes="(min-width: 768px) 33vw, 50vw"
									class="aspect-square w-full rounded-lg object-cover"
								/>
							))}
						</div>
					</section>
				)
			}
		</div>
	</article>
</BaseLayout>
