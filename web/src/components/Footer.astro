---
import { Image } from 'astro:assets';
import logo from '../assets/images/logo.png';
import { CONTACT, NAV_LINKS, SITE_TITLE } from '../consts';
import SocialIcons from './SocialIcons.astro';

const heading = 'eyebrow flex items-center gap-2 font-semibold text-muted';
const badge =
	'grid h-8 w-8 shrink-0 place-items-center rounded-full bg-white text-primary transition-colors';
const copyBtn =
	'copy-btn group/copy relative grid shrink-0 cursor-pointer place-items-center rounded-full text-primary transition-colors hover:bg-accent hover:text-white data-copied:bg-accent data-copied:text-white';
const copyTooltip =
	'pointer-events-none absolute -top-9 left-1/2 hidden -translate-x-1/2 rounded-md bg-dark px-2 py-1 text-xs whitespace-nowrap text-white group-data-copied/copy:block';
---

<footer>
	<div class="bg-light">
		<div class="container-site grid gap-10 py-16 md:grid-cols-[1.2fr_1fr_1fr]">
			<div>
				<a href="/" class="inline-flex items-center gap-3">
					<Image src={logo} alt="" width={56} height={56} class="h-14 w-14" />
					<span class="font-heading text-md leading-tight font-semibold text-dark">
						Udruženje <span class="text-accent">skipera</span><br />Crne Gore
					</span>
				</a>
				<SocialIcons
					class="mt-5 text-primary [&>a]:grid [&>a]:h-9 [&>a]:w-9 [&>a]:place-items-center [&>a]:rounded-full [&>a]:bg-white [&>a]:transition-colors [&>a]:hover:bg-accent [&>a]:hover:text-white [&>a]:hover:opacity-100 [&_svg]:h-4 [&_svg]:w-4"
				/>
			</div>

			<div>
				<h3 class={heading}>
					<svg viewBox="0 0 24 24" class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
						<rect x="2" y="4" width="20" height="16" rx="2"></rect>
						<path d="m22 7-10 6L2 7"></path>
					</svg>
					Email
				</h3>

				<div class="mt-3 flex max-w-sm items-center gap-2 rounded-full bg-white p-1.5 pl-4 shadow-[0_10px_30px_-18px_rgb(44_90_123/0.6)]">
					<a href={`mailto:${CONTACT.email}`} class="min-w-0 flex-1 truncate text-sm text-dark hover:text-primary" title={CONTACT.email}>
						{CONTACT.email}
					</a>
					<button
						type="button"
						class:list={[copyBtn, 'h-9 w-9 bg-light']}
						data-copy={CONTACT.email}
						data-label="Email adresa kopirana"
						aria-label="Kopiraj email adresu"
						title="Kopiraj"
					>
						<svg viewBox="0 0 24 24" class="h-4 w-4 group-data-copied/copy:hidden" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
							<rect x="9" y="9" width="13" height="13" rx="2"></rect>
							<path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path>
						</svg>
						<svg viewBox="0 0 24 24" class="hidden h-4 w-4 group-data-copied/copy:block" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
							<path d="M20 6 9 17l-5-5"></path>
						</svg>
						<span class={copyTooltip}>Kopirano!</span>
					</button>
				</div>

				<ul class="mt-6 space-y-3 text-dark">
					<li class="flex items-center gap-3">
						<span class={badge} aria-hidden="true">
							<svg viewBox="0 0 24 24" class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
								<path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"></path>
								<circle cx="12" cy="10" r="3"></circle>
							</svg>
						</span>
						{CONTACT.address}
					</li>
					<li class="flex items-center gap-3">
						<span class={badge} aria-hidden="true">
							<svg viewBox="0 0 24 24" class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
								<circle cx="12" cy="12" r="10"></circle>
								<path d="M12 6v6l4 2"></path>
							</svg>
						</span>
						{CONTACT.hours}
					</li>
				</ul>
			</div>

			<div>
				<h3 class={heading}>
					<svg viewBox="0 0 24 24" class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
						<path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.8 19.8 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.8 19.8 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.13.96.36 1.9.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.9.34 1.85.57 2.81.7A2 2 0 0 1 22 16.92Z"></path>
					</svg>
					Telefon
				</h3>
				<ul class="mt-3 space-y-2">
					{CONTACT.phones.map((phone) => (
						<li class="flex items-center gap-3">
							<button
								type="button"
								class:list={[copyBtn, 'h-8 w-8 bg-white']}
								data-copy={phone}
								data-label={`Broj ${phone} kopiran`}
								aria-label={`Kopiraj broj ${phone}`}
								title="Kopiraj"
							>
								<svg viewBox="0 0 24 24" class="h-3.5 w-3.5 group-data-copied/copy:hidden" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
									<rect x="9" y="9" width="13" height="13" rx="2"></rect>
									<path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path>
								</svg>
								<svg viewBox="0 0 24 24" class="hidden h-3.5 w-3.5 group-data-copied/copy:block" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
									<path d="M20 6 9 17l-5-5"></path>
								</svg>
								<span class={copyTooltip}>Kopirano!</span>
							</button>
							<a href={`tel:${phone.replace(/\s/g, '')}`} class="text-dark hover:text-primary">
								{phone}
							</a>
						</li>
					))}
				</ul>
			</div>
		</div>
	</div>

	<div class="bg-dark">
		<div class="container-site flex flex-col items-center gap-3 py-6 text-xs text-white/50 md:flex-row md:justify-between">
			<p class="text-center">&copy; {new Date().getFullYear()} {SITE_TITLE} &nbsp;|&nbsp; Sva prava zadržana</p>
			<nav aria-label="Footer navigacija">
				<ul class="flex flex-wrap justify-center gap-x-5 gap-y-1">
					{NAV_LINKS.map((link) => (
						<li>
							<a href={link.href} class="transition-colors hover:text-white">{link.label}</a>
						</li>
					))}
				</ul>
			</nav>
		</div>
	</div>
	<span id="copy-status" class="sr-only" aria-live="polite"></span>
</footer>

<script>
	const status = document.getElementById('copy-status');

	document.querySelectorAll<HTMLButtonElement>('.copy-btn').forEach((button) => {
		let timer: ReturnType<typeof setTimeout> | undefined;

		button.addEventListener('click', async () => {
			const text = button.dataset.copy ?? '';
			try {
				await navigator.clipboard.writeText(text);
			} catch {
				// Fallback for browsers/contexts without the async Clipboard API (e.g. plain http).
				const input = document.createElement('textarea');
				input.value = text;
				document.body.appendChild(input);
				input.select();
				document.execCommand('copy');
				input.remove();
			}
			button.dataset.copied = '';
			if (status) status.textContent = button.dataset.label ?? 'Kopirano';
			clearTimeout(timer);
			timer = setTimeout(() => {
				delete button.dataset.copied;
				if (status) status.textContent = '';
			}, 2000);
		});
	});
</script>
