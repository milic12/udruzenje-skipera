---
import { Image } from 'astro:assets';
import featureImage from '../../assets/images/signup-boats-marina.jpg';
import NameForm from '../NameForm.astro';
---

<section class="relative isolate flex min-h-[560px] items-center text-white md:min-h-[640px]">
	<Image
		src={featureImage}
		alt=""
		widths={[768, 1200]}
		sizes="100vw"
		class="absolute inset-0 -z-20 h-full w-full object-cover object-[65%_center] md:object-[70%_60%]"
	/>
	<!-- light fade from the section above + dark gradient behind the form -->
	<div
		class="absolute inset-0 -z-10 bg-[linear-gradient(180deg,var(--color-light)_0%,rgb(234_246_251/0)_18%),linear-gradient(0deg,rgb(13_20_26/0.75),rgb(13_20_26/0.25))] md:bg-[linear-gradient(180deg,var(--color-light)_0%,rgb(234_246_251/0.6)_10%,rgb(234_246_251/0)_26%),linear-gradient(90deg,rgb(13_20_26/0.7)_0%,rgb(13_20_26/0.35)_45%,rgb(13_20_26/0)_70%)]"
		aria-hidden="true"
	>
	</div>

	<div class="container-site">
		<div class="max-w-sm pt-32 pb-24">
			<h2 class="text-3xl leading-tight font-bold md:text-4xl">Prijavite se sada</h2>
			<NameForm source="home" class="mt-8" dark />
		</div>
	</div>
</section>
