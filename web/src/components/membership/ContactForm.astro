---
interface Props {
	eyebrow?: string;
	title?: string;
	lead?: string;
	border?: boolean;
}

const {
	eyebrow = 'Prijava',
	title = 'Postanite član',
	lead = 'Pošaljite nam poruku i javićemo vam se sa svim detaljima.',
	border = true,
} = Astro.props;

const field =
	'rounded-md border border-black/15 bg-white px-4 py-3 text-dark placeholder:text-muted/70 focus:border-accent focus:outline-none';
const label = 'font-heading text-sm font-medium text-dark';
---

<section class:list={['bg-white py-16 md:py-24', border && 'border-t border-black/10']}>
	<div class="container-site max-w-2xl">
		<div class="text-center">
			<span class="eyebrow text-primary">{eyebrow}</span>
			<h2 class="mt-3 text-3xl font-semibold text-dark">{title}</h2>
			<p class="mt-3 text-muted">{lead}</p>
		</div>

		<form
			class="mt-10 grid gap-5 rounded-lg bg-light p-6 shadow-[0_10px_30px_-18px_rgb(44_90_123/0.6)] sm:grid-cols-2 md:p-8"
			onsubmit="return false;"
		>
			<label class="flex flex-col gap-2">
				<span class={label}>Ime</span>
				<input type="text" name="firstName" autocomplete="given-name" placeholder="Vaše ime" class={field} />
			</label>
			<label class="flex flex-col gap-2">
				<span class={label}>Prezime</span>
				<input
					type="text"
					name="lastName"
					autocomplete="family-name"
					placeholder="Vaše prezime"
					class={field}
				/>
			</label>
			<label class="flex flex-col gap-2 sm:col-span-2">
				<span class={label}>E-mail*</span>
				<input
					type="email"
					name="email"
					required
					autocomplete="email"
					placeholder="ime@primjer.com"
					class={field}
				/>
			</label>
			<label class="flex flex-col gap-2 sm:col-span-2">
				<span class={label}>Poruka*</span>
				<textarea name="message" required rows="5" placeholder="Vaša poruka" class:list={[field, 'resize-y']}
				></textarea>
			</label>
			<button type="submit" class="btn mt-1 w-full sm:col-span-2 sm:w-auto sm:justify-self-start">
				Pošalji
			</button>
		</form>
	</div>
</section>
