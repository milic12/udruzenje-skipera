---
// Renders an image block placed inside Portable Text (the "Tekst" field).
import SanityImage from '../SanityImage.astro';

const { node } = Astro.props;
---

<figure class="not-prose my-8">
	<SanityImage
		image={node}
		widths={[480, 768, 1200]}
		sizes="(min-width: 768px) 768px, 100vw"
		class="w-full rounded-xl"
	/>
	{node.caption && <figcaption class="mt-2 text-center text-sm text-muted">{node.caption}</figcaption>}
</figure>
