---
// Responsive image served from the Sanity CDN (respects crop + hotspot from the Studio).
import type { SanityImageSource } from '@sanity/image-url';
import { urlFor } from '../utils/image';

interface SanityImageProps {
	asset?: unknown;
	alt?: string | null;
	lqip?: string | null;
	dimensions?: { width?: number | null; height?: number | null } | null;
}

interface Props {
	image: SanityImageProps | null | undefined;
	/** Rendered widths to put in srcset. */
	widths?: number[];
	sizes?: string;
	/** Force a crop ratio (width / height), e.g. 3/2. Omit to keep the original ratio. */
	aspect?: number;
	alt?: string;
	class?: string;
	loading?: 'lazy' | 'eager';
}

const {
	image,
	widths = [400, 768, 1200],
	sizes = '100vw',
	aspect,
	alt,
	class: className,
	loading = 'lazy',
} = Astro.props;

const source = image as SanityImageSource | undefined;
const natural = image?.dimensions;
const ratio =
	aspect ?? (natural?.width && natural?.height ? natural.width / natural.height : undefined);

const build = (w: number) => {
	let b = urlFor(source!).width(w);
	if (aspect) b = b.height(Math.round(w / aspect)).fit('crop');
	return b.url();
};

const largest = Math.max(...widths);
const srcset = image?.asset ? widths.map((w) => `${build(w)} ${w}w`).join(', ') : undefined;
---

{
	image?.asset && (
		<img
			src={build(largest)}
			srcset={srcset}
			sizes={sizes}
			width={largest}
			height={ratio ? Math.round(largest / ratio) : undefined}
			alt={alt ?? image.alt ?? ''}
			loading={loading}
			decoding="async"
			class={className}
			style={
				image.lqip
					? `background-image:url(${image.lqip});background-size:cover;background-position:center`
					: undefined
			}
		/>
	)
}
