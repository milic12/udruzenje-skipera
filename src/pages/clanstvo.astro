---
import NameForm from '../components/NameForm.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE_TITLE } from '../consts';
---

<BaseLayout
	title={`Članstvo | ${SITE_TITLE}`}
	description="Postanite član Udruženja skipera Crne Gore – podrška u primjeni sigurnosnih standarda i profesionalnom razvoju skipera i posada jahti."
>
	<section class="bg-light py-16 text-center md:py-20">
		<div class="container-site">
			<span class="eyebrow text-primary">{SITE_TITLE}</span>
			<h1 class="mt-3 text-4xl font-bold text-dark md:text-5xl">Članstvo</h1>
		</div>
	</section>

	<section class="bg-white py-16 md:py-24">
		<div class="container-site max-w-2xl">
			<h2 class="text-3xl font-semibold text-dark">Zašto postati član</h2>
			<p class="mt-4 leading-relaxed text-muted">
				Članstvo u udruženju donosi podršku u primjeni sigurnosnih standarda, pristup radionicama i
				seminarima, te povezivanje sa skiperima i članovima posade jahti iz cijele Crne Gore.
			</p>
			<NameForm class="mt-8 max-w-sm" />
		</div>
	</section>
</BaseLayout>
