import PageHeader from "../components/PageHeader.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import { SITE_TITLE } from "../consts";
---

<BaseLayout
  title={`Članstvo | ${SITE_TITLE}`}
  description="Postanite član Udruženja skipera Crne Gore – edukacija i saradnja sa obrazovnim institucijama, programi sigurnosti plovidbe i odgovori na česta pitanja o članstvu."
>
  <PageHeader
    title="Članstvo"
    titleClass="mt-8"
  >
   
  </PageHeader>

  <Projects />
  <Programs />
  <Faq />
  <ContactForm />
</BaseLayout>
