---
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE_TITLE } from '../consts';
---

<BaseLayout
	title={`Aktivnosti | ${SITE_TITLE}`}
	description="Radionice, seminari i druženja Udruženja skipera Crne Gore – edukacija i razmjena iskustava među skiperima i posadama jahti."
>
	<section class="bg-light py-16 text-center md:py-20">
		<div class="container-site">
			<span class="eyebrow text-primary">{SITE_TITLE}</span>
			<h1 class="mt-3 text-4xl font-bold text-dark md:text-5xl">Aktivnosti</h1>
		</div>
	</section>

	<section class="bg-white py-16 md:py-24">
		<div class="container-site grid max-w-4xl gap-10 md:grid-cols-2">
			<div>
				<h2 class="text-2xl font-semibold text-dark">Edukacija</h2>
				<p class="mt-3 leading-relaxed text-muted">
					Radionice i seminari za usavršavanje vještina skipera i posada.
				</p>
			</div>
			<div>
				<h2 class="text-2xl font-semibold text-dark">Događaji</h2>
				<p class="mt-3 leading-relaxed text-muted">
					Organizujemo druženja i razmjenu iskustava među članovima.
				</p>
			</div>
		</div>
	</section>
</BaseLayout>
