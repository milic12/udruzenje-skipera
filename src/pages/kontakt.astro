---
import BaseLayout from '../layouts/BaseLayout.astro';
import { CONTACT, SITE_TITLE } from '../consts';
---

<BaseLayout
	title={`Kontakt | ${SITE_TITLE}`}
	description="Kontaktirajte Udruženje skipera Crne Gore putem emaila ili telefona."
>
	<section class="bg-light py-16 text-center md:py-20">
		<div class="container-site">
			<span class="eyebrow text-primary">{SITE_TITLE}</span>
			<h1 class="mt-3 text-4xl font-bold text-dark md:text-5xl">Kontakt</h1>
		</div>
	</section>

	<section class="bg-white py-16 md:py-24">
		<div class="container-site grid max-w-4xl gap-10 md:grid-cols-2">
			<div>
				<h2 class="eyebrow font-semibold text-muted">Email</h2>
				<a href={`mailto:${CONTACT.email}`} class="mt-3 block break-all text-lg text-dark hover:text-primary">
					{CONTACT.email}
				</a>
			</div>
			<div>
				<h2 class="eyebrow font-semibold text-muted">Telefon</h2>
				<ul class="mt-3 space-y-1">
					{CONTACT.phones.map((phone) => (
						<li>
							<a href={`tel:${phone.replace(/\s/g, '')}`} class="text-lg text-dark hover:text-primary">
								{phone}
							</a>
						</li>
					))}
				</ul>
			</div>
		</div>
	</section>
</BaseLayout>
