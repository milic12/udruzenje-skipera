---
import Intro from '../components/about/Intro.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE_TITLE } from '../consts';
---

<BaseLayout
	title={`O nama | ${SITE_TITLE}`}
	description="Udruženje skipera i članova posade jahti iz Crne Gore posvećeno je sigurnosti i edukaciji na moru."
>
	<section class="bg-light py-16 text-center md:py-20">
		<div class="container-site">
			<span class="eyebrow text-primary">Udruženje skipera Crne Gore</span>
			<h1 class="mt-3 text-4xl font-bold text-dark md:text-5xl">O nama</h1>
		</div>
	</section>

	<Intro />
</BaseLayout>
