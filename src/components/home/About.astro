---
import { Image } from 'astro:assets';
import aboutImage from '../../assets/images/about.jpg';
---

<section class="bg-white py-20 md:py-28">
	<div class="container-site grid items-center gap-12 md:grid-cols-2">
		<div>
			<h3 class="text-3xl font-semibold text-dark md:text-4xl">O nama i našem radu</h3>
			<p class="mt-6 text-lg text-muted">
				Udruženje skipera i članova posade jahti iz Crne Gore posvećeno je sigurnosti i edukaciji na
				moru.
			</p>
			<a href="/clanstvo" class="btn mt-8">Saznaj više</a>
		</div>

		<div class="relative">
			<Image
				src={aboutImage}
				alt="Članovi Udruženja skipera Crne Gore"
				widths={[480, 768, 1024]}
				sizes="(min-width: 768px) 50vw, 100vw"
				class="aspect-[4/3] w-full rounded-2xl object-cover shadow-lg"
			/>
			<figure class="relative -mt-12 ml-6 max-w-xs rounded-xl bg-white p-5 shadow-lg md:absolute md:-bottom-8 md:-left-8 md:mt-0 md:ml-0">
				<span class="font-heading text-5xl leading-none text-accent" aria-hidden="true">"</span>
				<blockquote class="-mt-3 font-heading text-lg font-semibold text-dark">
					Pravi savez za profesionalce na moru.
				</blockquote>
				<figcaption class="mt-2 text-muted">Marko P.</figcaption>
			</figure>
		</div>
	</div>
</section>
