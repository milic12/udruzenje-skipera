---
import { Image } from 'astro:assets';
import membership from '../../assets/images/gallery-1.jpg';
import crew from '../../assets/images/boat-show.webp';
import meetup from '../../assets/images/service-meetup.jpg';

const services = [
	{
		image: meetup,
		alt: 'Radionica za skipere',
		title: 'Edukacija',
		text: 'Radionice i seminari za usavršavanje vještina skipera i posada.',
		href: '/aktivnosti',
		icon: '<path d="M2 9l10-5 10 5-10 5z"/><path d="M6 11v5c3 2 9 2 12 0v-5"/>',
	},
	{
		image: crew,
		alt: 'Posada na jahti',
		title: 'Događaji',
		text: 'Organizujemo druženja i razmjenu iskustava među članovima.',
		href: '/aktivnosti',
		icon: '<path d="M2 18c2 1.5 4 1.5 6 0s4-1.5 6 0 4 1.5 6 0M2 14c2 1.5 4 1.5 6 0s4-1.5 6 0 4 1.5 6 0"/><path d="M12 3v8M12 3l6 7h-6"/>',
	},
	{
		image: membership,
		alt: 'Potpisivanje sporazuma',
		title: 'Članstvo',
		text: 'Podrška u primjeni sigurnosnih standarda i profesionalnom razvoju.',
		href: '/clanstvo',
		icon: '<circle cx="12" cy="12" r="7"/><circle cx="12" cy="12" r="2"/><path d="M12 2v3M12 19v3M2 12h3M19 12h3M5 5l2 2M17 17l2 2M5 19l2-2M17 7l2-2"/>',
	},
];
---

<section class="relative isolate bg-white pt-6 pb-28">
	<div class="absolute inset-x-0 bottom-0 -z-10 h-64 bg-linear-to-b from-white to-light" aria-hidden="true"></div>

	<h2 class="container-site mb-10 text-center text-3xl font-semibold text-dark md:mb-12">Naše usluge</h2>

	<div class="container-site mx-auto grid max-w-md gap-12 md:max-w-6xl md:grid-cols-3 md:gap-5">
		{services.map((s) => (
			<article class="group text-center">
				<div class="relative aspect-[3/2] overflow-hidden">
					<Image
						src={s.image}
						alt={s.alt}
						widths={[400, 768]}
						sizes="(min-width: 768px) 33vw, 100vw"
						class="h-full w-full object-cover transition-transform duration-700 group-hover:scale-105"
					/>
					<div class="absolute inset-0 bg-dark/25" aria-hidden="true"></div>
					<svg
						class="absolute top-1/2 left-1/2 h-12 w-12 -translate-x-1/2 -translate-y-1/2 text-white"
						viewBox="0 0 24 24"
						fill="none"
						stroke="currentColor"
						stroke-width="1.3"
						stroke-linecap="round"
						stroke-linejoin="round"
						aria-hidden="true"
						set:html={s.icon}
					/>
				</div>
				<h3 class="mt-6 text-sm font-bold tracking-[0.08em] text-dark uppercase">{s.title}</h3>
				<p class="mx-auto mt-3 max-w-64 text-sm leading-relaxed text-muted">{s.text}</p>
				<a href={s.href} class="btn mt-5 px-5 py-2 text-xs">Saznaj više</a>
			</article>
		))}
	</div>
</section>
