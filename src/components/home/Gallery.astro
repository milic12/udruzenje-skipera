---
import { Image } from 'astro:assets';
import g1 from '../../assets/images/gallery-1.jpg';
import g2 from '../../assets/images/gallery-2.jpg';
import g3 from '../../assets/images/gallery-3.jpg';
import skadar from '../../assets/images/gallery-skadar.jpg';
import kotorYachts from '../../assets/images/gallery-kotor-yachts.jpg';
import kotorBoat from '../../assets/images/gallery-kotor-boat.jpg';

const images = [
	{ src: g1, alt: 'Galerija – fotografija 1' },
	{ src: g2, alt: 'Galerija – fotografija 2' },
	{ src: g3, alt: 'Galerija – fotografija 3' },
	{ src: skadar, alt: 'Skadarsko jezero' },
	{ src: kotorYachts, alt: 'Jahte u Bokokotorskom zalivu' },
	{ src: kotorBoat, alt: 'Brod u Bokokotorskom zalivu' },
];
---

<section class="bg-light py-20 md:py-28">
	<div class="container-site">
		<h3 class="text-center text-3xl font-semibold text-dark md:text-4xl">Galerija</h3>
		<div class="mt-12 grid grid-cols-2 gap-4 md:grid-cols-3 md:gap-6">
			{images.map((img) => (
				<Image
					src={img.src}
					alt={img.alt}
					widths={[375, 768]}
					sizes="(min-width: 768px) 33vw, 50vw"
					class="aspect-square w-full rounded-xl object-cover transition-transform duration-300 hover:scale-[1.02]"
				/>
			))}
		</div>
	</div>
</section>
