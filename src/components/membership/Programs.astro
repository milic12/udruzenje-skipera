---
import { Image } from 'astro:assets';
import education from '../../assets/images/clanstvo-edukacija.jpg';
import safety from '../../assets/images/clanstvo-sigurnost.jpg';

const programs = [
	{
		image: safety,
		alt: 'Skiper na palubi jahte',
		title: 'Sigurnost mora',
		text: 'Programi za unapređenje sigurnosti plovidbe.',
		icon: '<circle cx="12" cy="5" r="2"/><path d="M12 7v14M5 13a7 7 0 0 0 14 0M8 11h8"/>',
	},
	{
		image: education,
		alt: 'Paluba jahte na otvorenom moru',
		title: 'Edukacija',
		text: 'Radionice i treninzi za profesionalni razvoj.',
		icon: '<path d="M2 9l10-5 10 5-10 5z"/><path d="M6 11v5c3 2 9 2 12 0v-5"/>',
	},
];
---

<section class="bg-light py-16 md:py-24">
	<h2 class="container-site mb-10 text-center text-3xl font-semibold text-dark md:mb-12">
		Naši programi
	</h2>

	<div class="container-site mx-auto grid max-w-md gap-12 md:max-w-4xl md:grid-cols-2 md:gap-8">
		{
			programs.map((p) => (
				<article class="group text-center">
					<div class="relative aspect-[3/2] overflow-hidden">
						<Image
							src={p.image}
							alt={p.alt}
							widths={[400, 768]}
							sizes="(min-width: 768px) 50vw, 100vw"
							class="h-full w-full object-cover transition-transform duration-700 group-hover:scale-105"
						/>
						<div class="absolute inset-0 bg-dark/25" aria-hidden="true" />
						<svg
							class="absolute top-1/2 left-1/2 h-12 w-12 -translate-x-1/2 -translate-y-1/2 text-white"
							viewBox="0 0 24 24"
							fill="none"
							stroke="currentColor"
							stroke-width="1.3"
							stroke-linecap="round"
							stroke-linejoin="round"
							aria-hidden="true"
							set:html={p.icon}
						/>
					</div>
					<h3 class="mt-6 text-sm font-bold tracking-[0.08em] text-dark uppercase">{p.title}</h3>
					<p class="mx-auto mt-3 max-w-64 text-sm leading-relaxed text-muted">{p.text}</p>
					<a href="/aktivnosti" class="btn mt-5 px-5 py-2 text-xs">
						Saznaj više
					</a>
				</article>
			))
		}
	</div>
</section>
