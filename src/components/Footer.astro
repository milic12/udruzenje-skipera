---
import { CONTACT, SITE_TITLE } from '../consts';
import NameForm from './NameForm.astro';
import SocialIcons from './SocialIcons.astro';
---

<footer>
	<div class="bg-light">
		<div class="container-site grid gap-10 py-16 md:grid-cols-[1.2fr_1fr_1fr]">
			<div>
				<h2 class="text-2xl font-semibold text-dark">Budite u toku</h2>
				<p class="mt-2 text-muted">Prijavite se i pratite novosti udruženja.</p>
				<NameForm class="mt-5 max-w-sm" inline />
				<SocialIcons
					class="mt-5 text-primary [&>a]:grid [&>a]:h-9 [&>a]:w-9 [&>a]:place-items-center [&>a]:rounded-full [&>a]:bg-white [&>a]:transition-colors [&>a]:hover:bg-accent [&>a]:hover:text-white [&>a]:hover:opacity-100 [&_svg]:h-4 [&_svg]:w-4"
				/>
			</div>

			<div>
				<h3 class="eyebrow font-semibold text-muted">Email</h3>
				<a href={`mailto:${CONTACT.email}`} class="mt-3 block break-all text-dark hover:text-primary">
					{CONTACT.email}
				</a>
			</div>

			<div>
				<h3 class="eyebrow font-semibold text-muted">Telefon</h3>
				<ul class="mt-3 space-y-1">
					{CONTACT.phones.map((phone) => (
						<li>
							<a href={`tel:${phone.replace(/\s/g, '')}`} class="text-dark hover:text-primary">
								{phone}
							</a>
						</li>
					))}
				</ul>
			</div>
		</div>
	</div>

	<div class="bg-dark">
		<p class="container-site py-6 text-center text-xs text-white/50">
			&copy; {new Date().getFullYear()} {SITE_TITLE} &nbsp;|&nbsp; Sva prava zadržana
		</p>
	</div>
</footer>
