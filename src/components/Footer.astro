---
import { CONTACT } from '../consts';
import NameForm from './NameForm.astro';
import SocialIcons from './SocialIcons.astro';
---

<footer class="bg-dark text-white">
	<div class="container-site grid gap-10 py-16 md:grid-cols-[1.4fr_1fr_1fr]">
		<div>
			<h5 class="text-3xl font-semibold">Kontakt</h5>
			<p class="mt-3 text-white/80">Tu smo za sva vaša pitanja i sugestije.</p>
			<SocialIcons class="mt-6 text-white" />
			<NameForm class="mt-8 max-w-sm" dark />
		</div>

		<div>
			<h6 class="font-heading text-lg font-medium">Email</h6>
			<a href={`mailto:${CONTACT.email}`} class="mt-3 block break-all text-white/80 hover:text-accent">
				{CONTACT.email}
			</a>
		</div>

		<div>
			<h6 class="font-heading text-lg font-medium">Telefon</h6>
			<ul class="mt-3 space-y-1">
				{CONTACT.phones.map((phone) => (
					<li>
						<a href={`tel:${phone.replace(/\s/g, '')}`} class="text-white/80 hover:text-accent">
							{phone}
						</a>
					</li>
				))}
			</ul>
		</div>
	</div>

	<div class="border-t border-white/10">
		<p class="container-site py-6 text-sm text-white/60">&copy; 2025. All rights reserved.</p>
	</div>
</footer>
