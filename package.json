{
  "name": "udruzenjeskipera",
  "private": true,
  "type": "module",
  "workspaces": [
    "studio",
    "web"
  ],
  "scripts": {
    "dev": "concurrently -n web,studio -c blue,magenta \"npm run dev -w web\" \"npm run dev -w studio\"",
    "dev:web": "npm run dev -w web",
    "dev:studio": "npm run dev -w studio",
    "build": "npm run build -w web",
    "typegen": "npm run typegen -w studio",
    "deploy": "npm run deploy -w web"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "devDependencies": {
    "concurrently": "^9.2.1"
  }
}
